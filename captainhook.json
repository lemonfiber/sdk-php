{
    "config": {
        "fail-on-first-error": true
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {"action": "composer lint"},
            {"action": "composer analyse"},
            {"action": "composer guards"}
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {"action": "composer test"}
        ]
    },
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Beams",
                "options": {"subjectLength": 72, "bodyLineLength": 100}
            }
        ]
    }
}
